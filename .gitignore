# Python virtual environment (created per docs/setup-windows.md).
.venv/
# Python bytecode caches.
__pycache__/
# Model weights and converted model files: large, never commit them.
*.gguf
*.safetensors
# Downloaded base models, generated checkpoints, GGUFs and logits (see docs/development.md).
.cache/
# Top-level CMake build of the C API, the engine and the backend plugins (see docs/development.md).
/build/
# Python SDK packaging output (wheel build folders, bundled native files).
/python/build/
/python/dist/
*.egg-info/
/python/littlemore/_bin/
# Local developer tooling state and scratch notes: never part of the project.
.superpowers/
.claude-flow/
.swarm/
.claude/
.pytest_cache/
